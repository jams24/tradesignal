# ============================================================
# CryptoSignalDeep — Required
# ============================================================

# Database
DATABASE_URL=postgresql://cryptosignal:cryptosignal@localhost:5432/cryptosignaldeep
REDIS_URL=redis://localhost:6379

# DeepSeek LLM (for research agent & narrative analysis)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# ============================================================
# Exchange API Keys (for execution)
# ============================================================
BINANCE_API_KEY=
BINANCE_SECRET=

MEXC_API_KEY=
MEXC_SECRET=

BYBIT_API_KEY=
BYBIT_SECRET=

BITGET_API_KEY=
BITGET_SECRET=

# ============================================================
# On-Chain API Keys
# ============================================================
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
SOLSCAN_API_KEY=

# Helius RPC (Solana — best for real-time DEX monitoring)
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# QuickNode / Alchemy (EVM chains)
ETH_RPC_URL=
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
BSC_RPC_URL=
ARBITRUM_RPC_URL=

# ============================================================
# Social APIs
# ============================================================
TWITTER_BEARER_TOKEN=

# ============================================================
# Telegram
# ============================================================
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id
TELEGRAM_ADMIN_CHAT_ID=your-admin-chat-id

# ============================================================
# Trading Parameters
# ============================================================
MAX_POSITION_SIZE_USD=1000
MAX_PORTFOLIO_HEAT=0.5
MAX_SLIPPAGE_PCT=3
DEFAULT_LEVERAGE=5

# Scan intervals (in minutes)
MEME_SCOUT_INTERVAL=1
SMART_MONEY_INTERVAL=2
ONCHAIN_INTEL_INTERVAL=5
TECHNICAL_ALPHA_INTERVAL=5
SOCIAL_NARRATIVE_INTERVAL=10

# Risk limits
MAX_DAILY_LOSS_PCT=10
MAX_DRAWDOWN_PCT=25
MIN_CONVICTION_SCORE=65
